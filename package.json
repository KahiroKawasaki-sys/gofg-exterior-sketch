{
  "name": "gofg-exterior-sketch",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "cf:types": "wrangler types --strict-vars=false",
    "check:worker": "tsc --noEmit -p tsconfig.worker.json",
    "check:bundle": "wrangler deploy --dry-run",
    "cf:login": "node scripts/cloudflare-account.mjs login",
    "cf:whoami": "node scripts/cloudflare-account.mjs status",
    "cf:activate": "node scripts/cloudflare-account.mjs activate",
    "cf:deploy": "node scripts/cloudflare-account.mjs deploy",
    "cf:check": "node scripts/cloudflare-account.mjs deploy --dry-run",
    "cf:verify": "node scripts/check-access.mjs",
    "cf:login-storage": "node scripts/cloudflare-account.mjs login-storage",
    "cf:storage:list": "node scripts/cloudflare-account.mjs storage-list",
    "cf:storage:create": "node scripts/cloudflare-account.mjs storage-create",
    "cf:storage:bind": "node scripts/bind-storage.mjs",
    "cf:storage:migrate": "node scripts/cloudflare-account.mjs storage-migrate"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  }
}
