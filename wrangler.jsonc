{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gofg-exterior-sketch",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ALLOWED_EMAIL": "",
    "PUBLIC_APP": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
